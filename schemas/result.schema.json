{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://madcat.studio/schemas/shared-bus-result.schema.json",
  "title": "MadCat shared bus result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "result_id",
    "command_id",
    "completed_at",
    "agent",
    "status",
    "observed_command_hash",
    "nonce",
    "summary",
    "checks",
    "external_actions",
    "credits_spent",
    "signature",
    "result_hash"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "protocol": {"const": "MADCAT-SHARED-BUS-1.0"},
    "result_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "command_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "agent": {"const": "Grok"},
    "status": {"enum": ["completed", "partial", "blocked"]},
    "observed_command_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonce": {"type": "string", "minLength": 16},
    "summary": {"type": "string", "minLength": 1},
    "checks": {"type": "array"},
    "external_actions": {"type": "array"},
    "credits_spent": {"type": "number", "minimum": 0},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "algorithm", "key_id", "value"],
      "properties": {
        "version": {"const": 1},
        "algorithm": {"const": "Ed25519"},
        "key_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "result_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
